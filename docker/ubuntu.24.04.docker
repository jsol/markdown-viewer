FROM ubuntu:24.04

RUN apt-get update && apt-get install -y git build-essential cmake ninja-build meson libgtk-4-dev libadwaita-1-dev

RUN mkdir /deps/ && cd /deps/ &&  git clone https://github.com/github/cmark-gfm.git && cd cmark-gfm && mkdir build && cd build && cmake .. && make && make install

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]


